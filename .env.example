# Hack-A-Gent configuration
#
# Copy to `.env` and fill in values. NEVER commit `.env`.
#
# Provider selection precedence:
#   1. Explicit HACKAGENT_PROVIDER / LLM_PROVIDER (highest priority)
#   2. A provider-native key below (auto-selects its provider)
#   3. The provider stored in ~/.hackagent/config.json
#
# Explicit provider. One of:
#   anthropic | openai | gemini | openrouter | nvidia | nebius | custom
# HACKAGENT_PROVIDER=gemini

# Provider-native keys (auto-select the provider when HACKAGENT_PROVIDER is unset)
GEMINI_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# NVIDIA_API_KEY=
# NEBIUS_API_KEY=

# Custom endpoint (only when HACKAGENT_PROVIDER=custom)
# HACKAGENT_BASE_URL=https://integrate.api.nvidia.com/v1
# HACKAGENT_API_KEY=
# HACKAGENT_MODEL=

# OpenRouter is opt-in and never auto-selected, even when this key is set,
# so it will not silently take over from another provider. Pair it with
# HACKAGENT_PROVIDER=openrouter to activate it.
# OPENROUTER_API_KEY=

# Key read by the `custom` provider when the endpoint is not a managed one.
# CUSTOM_LLM_API_KEY=

# Deployment tokens (optional)
# GITHUB_TOKEN=
# VERCEL_TOKEN=
# NETLIFY_AUTH_TOKEN=
